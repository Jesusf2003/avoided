//
// Quake game definition file (.fgd)
// for Jackhammer 1.0 and above
//
// written by autolycus / autolycus@planetquake.com
// modified by XaeroX / support@hlfx.ru
//
// Trimmed down to match the entities actually implemented in src/
// (this mod currently has no items, weapons, monsters, doors, plats,
// buttons or triggers other than trigger_changelevel).
//

//
// worldspawn
//

@SolidClass = worldspawn : "World entity"
[
	message(string) : "Text on entering the world"
	worldtype(choices) : "Ambience" : 0 =
	[
		0 : "Medieval"
		1 : "Runic (metal)"
		2 : "Present (base)"
	]
	sky(sky) : "Sky name (modified engines only)"
	sounds(integer) : "CD track to play" : 1
	light(integer) : "Default light level"
]

//
// base marker definitions
//

@baseclass = Targetname [ targetname(target_source) : "Name" ]
@baseclass = Target [ target(target_destination) : "Target" ]

//
// player starts, coop, intermission
//
// (no deathmatch/coop rules are wired up beyond spawn-point selection;
// info_player_deathmatch and info_player_coop are still consumed by
// SelectSpawnPoint in src/server/client.qc)
//

@baseclass flags(Angle) size(-16 -16 -24, 16 16 32) offset(0 0 24)
	color(0 255 0) = PlayerClass []

@PointClass base(PlayerClass) = info_player_start : "Player 1 start" []
@PointClass base(PlayerClass) = info_player_start2 : "Player episode return point" []
@PointClass base(PlayerClass) = info_player_deathmatch : "Player deathmatch start" []
@PointClass base(PlayerClass) = info_player_coop : "Player cooperative start" []

@PointClass size(-16 -16 -16, 16 16 16) color(255 128 128) = info_intermission : "Intermission camera"
[
	mangle(string) : "Viewing angle (pitch roll yaw)"
]

//
// generic positional markers
//

@PointClass base(Targetname) = info_null : "Positional target (removed at spawn)" []
@PointClass base(Targetname) = info_notnull : "Positional target (stays in the world)" []

//
// items
//
// shared pickup/respawn scaffolding lives in src/items/items.qc (StartItem,
// ItemTouched); each item family (e.g. src/items/item_armor.qc) only adds
// its own model/sound/values on top of it.
//

@baseclass base(Targetname, Target) = Item
[
	wait(integer) : "Respawn delay in deathmatch (seconds, 0 = default 20)" : 0
]

@PointClass size(-16 -16 0, 16 16 56) base(Item) studio("progs/armor.mdl") skin(0) =
	item_armor1 : "Green armor (200 points, absorbs 30% damage)" []

//
// funcs
//
// shared brush-entity scaffolding lives in src/funcs/funcs.qc (StartBrush);
// each mover (e.g. src/funcs/func_detail.qc) only adds its own behavior on
// top of it.
//

@SolidClass = func_detail : "Simple solid, non-moving brush (placeholder, no behavior yet)" []

//
// lights
//
// light/style are read by the light compiler tool, not by QuakeC. The
// lightstyle-toggling behavior below (light, light_fluoro) is the only
// runtime logic these entities have.
//

@baseclass = Light [
	light(integer) : "Brightness" : 200
	style(Choices) : "Appearance" : 0 =
	[
		0 : "Normal"
		10: "Fluorescent flicker"
		2 : "Slow, strong pulse"
		11: "Slow pulse, noblack"
		5 : "Gentle pulse"
		1 : "Flicker A"
		6 : "Flicker B"
		3 : "Candle A"
		7 : "Candle B"
		8 : "Candle C"
		4 : "Fast strobe"
		9 : "Slow strobe"
	]
]

@PointClass size(-8 -8 -8, 8 8 8) flags(Light) base(Targetname, Light) iconsprite("sprites/light.spr") =
	light : "Invisible lightsource (toggles if style >= 32 and targeted)"
	[
		spawnflags(Flags) = [ 1 : "Initially dark" : 0 ]
	]
@PointClass size(-8 -8 -8, 8 8 8) flags(Light) base(Targetname, Light) iconsprite("sprites/light.spr") =
	light_fluoro : "Fluorescent light (humming sound, toggles if style >= 32 and targeted)"
	[
		spawnflags(Flags) = [ 1 : "Initially dark" : 0 ]
	]
@PointClass size(-8 -8 -8, 8 8 8) flags(Light) base(Light) iconsprite("sprites/light.spr") =
	light_fluorospark : "Sparking fluorescent light (buzzing sound)" []
@PointClass size(-8 -8 -8, 8 8 8) sprite("progs/s_light.spr") =
	light_globe : "Globe light (static model)" []
@PointClass size(-10 -10 -12, 12 12 18) offset(0 0 12) studio("progs/flame2.mdl") =
	light_flame_large_yellow : "Large yellow flame (static model)" []
@PointClass size(-10 -10 -12, 12 12 18) offset(0 0 12) studio("progs/flame2.mdl") =
	light_flame_small_yellow : "Small yellow flame (static model)" []
@PointClass size(-10 -10 -12, 12 12 18) offset(0 0 12) studio("progs/flame2.mdl") =
	light_flame_small_white : "Small white flame (static model)" []
@PointClass size(-10 -10 -20, 10 10 20) offset(0 0 20) studio("progs/flame.mdl") =
	light_torch_small_walltorch : "Small walltorch (static model)" []

//
// triggers
//

@SolidClass base(Targetname, Target) = trigger_changelevel : "Trigger: Change level"
[
	map(string) : "New map name"
	message(string) : "Message printed to the player who touches it"
	killtarget(target_destination) : "Kill target"
	delay(integer) : "Delay before firing target/killtarget"
	spawnflags(flags) =
	[
		1: "No Intermission" : 0
	]
]
