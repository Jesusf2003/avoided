//
// Avoided game definition file (.fgd)
// for Jackhammer(Steam version) and above
//
// written by Jesusf2003 / https://github.com/Jesusf2003
//

//
// worldspawn
//
@SolidClass = worldspawn : "World entity"
[
	message(string) : "Text on entering the world"
	sky(sky) : "Sky name (modified engines only)"
	sounds(integer) : "CD track to play" : 1
	light(integer) : "Default light level"
]

@baseclass = Appearflags [
]

@baseclass base(Appearflags) flags(Angle) size(-16 -16 -24, 16 16 32) offset(0 0 24) color(50 255 50) = PlayerClass []

@PointClass base(PlayerClass) studio("models/testplayer.iqm") = info_player_start : "Player 1 start" []
@PointClass = info_null : "info_null (spotlight target)"
[
	targetname(target_source) : "Name" 
]